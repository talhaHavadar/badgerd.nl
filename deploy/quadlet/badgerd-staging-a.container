# badgerd.nl staging replica A on 127.0.0.1:5001 (nginx upstream). Installed to ~/.config/containers/systemd/.
# `podman auto-update` (timer) pulls new `:staging` digests and restarts the replicas one at a time.
[Unit]
Description=badgerd.nl staging replica A (127.0.0.1:5001)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=badgerd-staging-a
Image=ghcr.io/talhahavadar/badgerd.nl:staging
AutoUpdate=registry
PublishPort=127.0.0.1:5001:5000
EnvironmentFile=%h/.config/badgerd/staging.env
# IMAGE_DIGEST for /healthz, written by ExecStartPre below.
EnvironmentFile=%t/%N.image.env
# Exec form: the distroless image has no /bin/sh.
HealthCmd=["/app/badgerd-web", "-healthcheck"]
HealthInterval=30s
HealthTimeout=3s
HealthRetries=3

[Service]
# Record the digest the tag currently points to (what podman run is about to start; after an auto-update or
# rollback that's the new/restored image). Before the very first pull it is left empty.
ExecStartPre=/bin/sh -c '/usr/bin/podman image inspect --format "IMAGE_DIGEST={{.Digest}}" ghcr.io/talhahavadar/badgerd.nl:staging > %t/%N.image.env 2>/dev/null || true'
# The unit only counts as started once /healthz answers. On podman 4.9 (no --sdnotify=healthy) this is what
# makes auto-update wait before restarting the other replica, and roll back if the new image never gets healthy.
ExecStartPost=/usr/bin/curl -fsS -o /dev/null --retry 30 --retry-delay 1 --retry-all-errors --max-time 2 http://127.0.0.1:5001/healthz
Restart=always
RestartSec=5
# Covers the first image pull plus the health wait above.
TimeoutStartSec=180

[Install]
WantedBy=default.target
