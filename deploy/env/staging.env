# Runtime config for the staging replicas (badgerd-staging-{a,b}); installed to ~/.config/badgerd/staging.env.
# Point GOVERNOR_BASE_URL at a staging governor here once one exists.
BASE_URL=https://staging.badgerd.nl
GOVERNOR_BASE_URL=https://governor.badgerd.nl
GIPHY_BASE_URL=https://media.giphy.com
TZ=Europe/Amsterdam
