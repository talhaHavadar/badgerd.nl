# Runtime config for the prod replicas (badgerd-prod-{a,b}); installed to ~/.config/badgerd/prod.env.
# The container always listens on PORT=5000 (set in the image); the host port comes from the .container file.
BASE_URL=https://badgerd.nl
GOVERNOR_BASE_URL=https://governor.badgerd.nl
GIPHY_BASE_URL=https://media.giphy.com
TZ=Europe/Amsterdam
