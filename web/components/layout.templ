package components

import (
	"badgerd.nl/internal/seo"
	"badgerd.nl/web"
)

// Page is the per-request data the shared layout needs.
type Page struct {
	Meta      seo.Meta
	ShowBreak bool     // seasonal "we are on a break" banner, see BreakNotice
	Scripts   []string // static JS paths (relative to web/static) loaded with defer
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en" style="font-family: Montserrat">
		<head>
			<meta charset="utf-8"/>
			<title>{ p.Meta.Title }</title>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ p.Meta.Description }/>
			if p.Meta.OG != nil {
				<meta property="og:title" content={ p.Meta.OG.Title }/>
				<meta property="og:description" content={ p.Meta.OG.Description }/>
				<meta property="og:type" content={ p.Meta.OG.Type }/>
				<meta property="og:image" content={ p.Meta.OG.Image }/>
				<meta property="og:url" content={ p.Meta.OG.URL }/>
				<meta property="og:locale" content={ p.Meta.OG.Locale }/>
			}
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>
			<link rel="manifest" href="/site.webmanifest"/>
			if p.Meta.Canonical != "" {
				<link rel="canonical" href={ p.Meta.Canonical }/>
			}
			<link rel="dns-prefetch" href="https://fonts.gstatic.com/"/>
			<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="anonymous"/>
			<link rel="preconnect" href="https://fonts.googleapis.com/"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500;600;700;800&display=swap"/>
			<link rel="stylesheet" href={ web.AssetURL("css/app.css") }/>
			@templ.Raw(themeInitScript)
			@jsonLD(p.Meta)
			<script src={ web.AssetURL("js/theme.js") } defer></script>
			for _, src := range p.Scripts {
				<script src={ web.AssetURL(src) } defer></script>
			}
		</head>
		<body>
			@dimHighlightsFilter()
			<div class="bg-surface text-fg">
				@nav(p.ShowBreak)
				<main>
					{ children... }
				</main>
				@footer()
			</div>
		</body>
	</html>
}

// themeInitScript sets the theme class before first paint (no light flash): the stored nav-toggle choice, else the OS
// preference. Kept inline and tiny on purpose; the toggle itself lives in /js/theme.js.
const themeInitScript = `<script>(function(){var t=null;try{t=localStorage.getItem('theme')}catch(e){}` +
	`var d=t?t==='dark':matchMedia('(prefers-color-scheme: dark)').matches;` +
	`document.documentElement.classList.toggle('dark',d)})()</script>`

	// dimHighlightsFilter is the SVG filter used by `.dark main img` (see web/css/input.css): per channel it is the
	// identity up to 0.6, then eases into a 0.8 ceiling, so highlights are capped without darkening the rest. It must
	// live in the page itself, as not every browser resolves CSS filter references to external files.

templ dimHighlightsFilter() {
	<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
		<filter id="dim-highlights" color-interpolation-filters="sRGB">
			<feComponentTransfer>
				<feFuncR type="table" tableValues="0 .1 .2 .3 .4 .5 .6 .675 .74 .785 .8"></feFuncR>
				<feFuncG type="table" tableValues="0 .1 .2 .3 .4 .5 .6 .675 .74 .785 .8"></feFuncG>
				<feFuncB type="table" tableValues="0 .1 .2 .3 .4 .5 .6 .675 .74 .785 .8"></feFuncB>
			</feComponentTransfer>
		</filter>
	</svg>
}

// themeToggle switches between light and dark; aria-pressed is kept in sync by /js/theme.js.
templ themeToggle() {
	<button type="button" data-theme-toggle aria-pressed="false" aria-label="Dark theme" title="Toggle dark theme" class="block rounded p-2 text-zinc-200 transition-all ease-in-out hover:text-zinc-50">
		<svg class="h-5 w-5 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
		<svg class="hidden h-5 w-5 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
		</svg>
	</button>
}

templ jsonLD(m seo.Meta) {
	if ld, err := m.JSONLDScript(); err == nil && ld != "" {
		@templ.Raw(`<script type="application/ld+json">` + ld + `</script>`)
	}
}

templ navLink(href, label string) {
	<a href={ templ.SafeURL(href) } class="mx-4 flex items-center justify-center p-2 transition-all ease-in-out hover:font-medium hover:text-zinc-50">{ label }</a>
}

templ nav(showBreak bool) {
	<div class="relative flex flex-wrap items-center justify-start bg-zinc-700 text-sm font-normal text-zinc-200 subpixel-antialiased">
		<div class="w-1/6"></div>
		<a href="/" class="mx-4 p-1">
			@Logo()
		</a>
		<div class="flex grow flex-wrap justify-center">
			@navLink("/", "STORE")
			@navLink("/sdwire3/", "SDWire3")
			@navLink("/nrfnano/", "nRFNANO")
			@navLink("/sdwirec/", "SDWireC")
			@navLink("/usbmux/", "USBMux")
		</div>
		<div class="w-1/6"></div>
		<div class="absolute top-1.5 right-2 sm:right-4">
			@themeToggle()
		</div>
		if showBreak {
			@breakBanner()
		}
	</div>
}

templ breakBanner() {
	<div class="christmas-message" style="flex-basis: 100%; height: 0"></div>
	<div class="christmas-message flex grow flex-col">
		<ul class="lightrope">
			for range 42 {
				<li></li>
			}
		</ul>
		<div class="min-h-20 grow items-center justify-center bg-red-700 font-bold text-zinc-300">
			<p class="mt-12 p-3 text-center">
				We are on a break! 
				<br/>
				{ BreakNotice.Message }
			</p>
		</div>
	</div>
}

templ footerLink(href string) {
	<a href={ templ.SafeURL(href) } class="p-1 hover:text-fg-muted-hover">
		{ children... }
	</a>
}

templ footer() {
	<div class="flex min-h-[20vh] w-full flex-row flex-wrap justify-between border border-t-line-strong bg-surface-alt p-8 text-fg-muted subpixel-antialiased">
		<div class="flex flex-col items-start justify-end font-thin subpixel-antialiased">
			<p class="font-light">
				* Shipments outside the EU may require customers to pay additional costs for Tax&Duties depending on the laws
				of destination country.
			</p>
			<p>KvK# 87317427</p>
			<p>Copyright © 2023 Badgerd Technologies B.V. All rights reserved.</p>
		</div>
		<div class="flex grow flex-col items-end">
			<div class="flex grow items-end">
				@GitHubLink("https://github.com/Badger-Embedded")
			</div>
			<div class="flex items-end">
				<a href="mailto:info@badgerd.nl" rel="nofollow" class="p-1 hover:text-fg-muted-hover">Contact</a>
				@footerLink("/refund/") {
					Refund
				}
				@footerLink("/terms/") {
					Terms <span class="hidden sm:inline">of Service</span>
				}
				@footerLink("/privacy/") {
					Privacy
				}
				@footerLink("/legal/") {
					Legal Notice
				}
			</div>
		</div>
	</div>
}
